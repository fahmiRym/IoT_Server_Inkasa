APP_NAME="NOC Command Center"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- DATABASE ---
# Production pakai MySQL. Local dev boleh sqlite.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=noc_monitor
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- MAIL (dipakai untuk OTP login) ---
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@inkalum.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ==================================================
# NOC Dashboard — konfigurasi kustom
# ==================================================

# --- Ingest sensor ESP32 ---
# API key wajib dikirim ESP32 di body POST /api/sensor/store
# Generate: `php -r "echo bin2hex(random_bytes(24));"`
SENSOR_API_KEY=

# Batas alarm (Telegram alert saat melewati)
SENSOR_TEMP_LIMIT=35
SENSOR_SMOKE_LIMIT=600

# --- Telegram Bot ---
# Buat bot via @BotFather → dapatkan token
# Dapatkan chat_id dari @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- CCTV / MediaMTX ---
CCTV_RTSP_URL=rtsp://127.0.0.1:8554/cctv1
CCTV_LABEL="Ruang Server"

# --- Motion Detector (service: motion-detector) ---
MOTION_MIN_AREA=1500
MOTION_CONSEC=3
MOTION_COOLDOWN=60
MOTION_RECORD_SECS=8
YOLO_CONF=0.4
# true = hanya kirim notif kalau ada ORANG (matikan alarm gerakan non-manusia)
ALERT_ONLY_PERSON=false
# Anti-false-alarm saat lampu ruangan padam/nyala
DARK_MIN_BRIGHTNESS=25
DARK_DELTA=40
DARK_RESETTLE_SEC=20

# --- Cloudflare Tunnel ---
CF_TUNNEL_TOKEN=
